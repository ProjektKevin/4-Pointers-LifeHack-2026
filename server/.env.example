# Port the Express server listens on
BACK_END_PORT=8080

# URL of the frontend, used for CORS (Vite dev default is 5173)
FRONT_END_URL=http://localhost:5173

# PostgreSQL connection string (e.g. from Neon, Supabase, or local Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# OpenAI API key, used for real-time shopping query intent extraction
# (AgentReady Query Lab). Falls back to a local regex parser if unset/unreachable.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
